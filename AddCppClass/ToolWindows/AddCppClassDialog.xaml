<platform:DialogWindow  x:Class="Dwarfovich.AddCppClass.AddCppClassDialog"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:platform="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                        xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"
                        xmlns:local="clr-namespace:Dwarfovich.AddCppClass"
                        toolkit:Themes.UseVsTheme="False"
                        mc:Ignorable="d"
                        ResizeMode="NoResize"
                        SizeToContent="WidthAndHeight">

    <Window.Resources>
        <local:Settings x:Key="className"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="282"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="282"/>
            <ColumnDefinition Width="75"/>
            <ColumnDefinition Width="12"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="0">
            <Label Content="Class name" Padding="0" VerticalContentAlignment="Center" ToolTip="Hello"/>
        </StackPanel>
        <TextBox Name="classNameTextBox" TextBox.TextChanged="ClassNameChangedEventHandler" Grid.Column="1"  Grid.Row="1" VerticalContentAlignment="Center"/>
        <TextBlock IsHitTestVisible="False" Text="Class name" Grid.Column="1" Foreground="DarkGray" Grid.Row="1" Margin="18,12,-54,93" Grid.ColumnSpan="2">
            <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=classNameTextBox}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="2">
            <Label Content="Namespace"  Padding="0" VerticalContentAlignment="Center" />
        </StackPanel>
        <ComboBox Name="NamespaceCombo" Grid.Column="1" Grid.Row="3" TextBoxBase.TextChanged="NamespaceChangedEventHandler" IsEditable="True" VerticalAlignment="Center" VerticalContentAlignment="Center"/>

        <Label Content="Header" Grid.Row="6" Grid.Column="1" VerticalContentAlignment="Center" Padding="0"/>
        <TextBox Name="HeaderFilename" TextChanged="HeaderFilenameChangedEventHandler" Grid.Column="1" Grid.Row="7" VerticalContentAlignment="Center" TextWrapping="Wrap" Text="TextBox"/>
        <StackPanel Orientation="Horizontal" Grid.Row="8" Grid.Column="1">
            <Label Grid.Column="1" Content="Source" Padding="0"  VerticalContentAlignment="Center" Margin="0,0,10,0"/>
            <CheckBox Name="CreateCppFileCheckBox" Content="Create .cpp file" Checked="CreateCppFileCheckChanged" Unchecked="CreateCppFileCheckChanged" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
        </StackPanel>
        <TextBox x:Name="CppFilename" TextChanged="CppFilenameChangedEventHandler" Grid.Column="1" Grid.Row="9" TextWrapping="Wrap" Text="TextBox" VerticalContentAlignment="Center"/>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2">
            <Label Content="Header subfolder" Padding="0" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
            <CheckBox Name="UseSingleSubfolderCheckBox" Content="Use single subfolder" Checked="UseSingleSubfolderCheckChanged" Unchecked="UseSingleSubfolderCheckChanged" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
        </StackPanel>
        <ComboBox Grid.Column="3" Grid.Row="1"  x:Name="HeaderSubfolderCombo" TextBoxBase.TextChanged="HeaderSubfolderChangedEventHandler" IsEditable="True" Grid.ColumnSpan="1"/>
        <Label Grid.Column="3" Grid.ColumnSpan="2" Content="Source subfolder" Grid.Row="2" VerticalContentAlignment="Center" Padding="0"/>
        <ComboBox Grid.Column="3" Name="CppSubfolderCombo" TextBoxBase.TextChanged="CppSubfolderChangedEventHandler" IsEditable="True" Grid.Row="3" Grid.ColumnSpan="1"/>
        <StackPanel Orientation="Horizontal" Grid.Row="8" Grid.Column="3" Grid.ColumnSpan="2">
            <CheckBox Content="Create filters" Name="CreateFiltersCheckBox" Checked="OnAnyFilterCheckBoxChanged" Unchecked="OnAnyFilterCheckBoxChanged" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
            <CheckBox Content="Use subfolder as filter" Name="UseSubfolderAsFilterCheckBox" Checked="OnAnyFilterCheckBoxChanged" Unchecked="OnAnyFilterCheckBoxChanged" VerticalContentAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="9" Grid.Column="3" Grid.ColumnSpan="2">
            <Label Grid.Column="3" Grid.ColumnSpan="2" Content="Header filter" VerticalContentAlignment="Center" Padding="0" Margin="0,0,10,0"/>
            <CheckBox Content="Use single filter" Name="UseSingleFilterCheckBox" Checked="OnAnyFilterCheckBoxChanged" Unchecked="OnAnyFilterCheckBoxChanged" VerticalContentAlignment="Center"/>
        </StackPanel>
        <ComboBox Grid.Column="3" Name="HeaderFilter" TextBoxBase.TextChanged="HeaderFilterChangedEventHandler" IsEditable="True" Grid.Row="10" Grid.ColumnSpan="1"/>
        <Label Grid.Column="3" Grid.ColumnSpan="2" Content="Source filter" Grid.Row="11" VerticalContentAlignment="Center" Padding="0"/>
        <ComboBox Grid.Column="3" Name="CppFilter" TextBoxBase.TextChanged="CppFilterChangedEventHandler" IsEditable="True" Grid.Row="12" Grid.ColumnSpan="1"/>

        <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="1">
            <CheckBox Content="Use headers root folder" Name="UseHeaderRoot" Checked="OnUseHeaderRootCheckBoxChecked" Unchecked="OnUseHeaderRootCheckBoxChecked" VerticalContentAlignment="Center"/>
        </StackPanel>
        <TextBox Grid.Column="3" Name="HeaderRoot" TextBox.TextChanged="HeaderRootChanged" Grid.Row="5" Grid.ColumnSpan="1"/>
        <StackPanel Orientation="Horizontal" Grid.Row="6" Grid.Column="3" Grid.ColumnSpan="1">
            <CheckBox Content="Use sources root folder" Name="UseCppRoot" Checked="OnUseCppRootCheckBoxChecked" Unchecked="OnUseCppRootCheckBoxChecked" VerticalContentAlignment="Center"/>
        </StackPanel>
        <TextBox Grid.Column="3" Name="CppRoot" TextBox.TextChanged="CppRootChanged" Grid.Row="7" Grid.ColumnSpan="1"/>

        <StackPanel Orientation="Vertical" Grid.Row="13" Grid.Column="3" Grid.ColumnSpan="2" Grid.RowSpan="4" VerticalAlignment="Top" HorizontalAlignment="Right"  Margin="55,20,0,0">
            <CheckBox Content="Save settings" Name="AutoSaveSettingsCheckBox"/>
            <Button x:Name="AddClassButton" Click="AddClassButtonClicked" Content="Add class" Width="120" Height="35" HorizontalAlignment="Left" Margin="0,5,0,0"/>
        </StackPanel>

        <CheckBox Content="Include precompiled header" Name="IncludePrecompiledHeaderCheckBox" Grid.Row="4" Grid.Column="1" Checked="IncludePrecompiledHeaderCheckChanged" Unchecked="IncludePrecompiledHeaderCheckChanged" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Name="PrecompiledHeader" Text="pch.h" TextChanged="PrecompiledHeaderFilenameChangedEventHandler" Grid.Row="5" TextWrapping="Wrap"/>

        <Grid Grid.Column="1" Grid.Row="10" Grid.RowSpan="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>

            <GroupBox Header="Filename style"
          Grid.Column="0"
          Grid.Row="0"
          VerticalAlignment="Top">
                <StackPanel>
                    <RadioButton Content="PascalCase"
                     Name="PascalCaseNameStyle"
                     GroupName="filenameStyleGroup"
                     IsChecked="True"
                     Checked="FilenameStyleRadioButtonChecked"/>

                    <RadioButton Content="snake__case"
                     Name="SnakeCaseNameStyle"
                     GroupName="filenameStyleGroup"
                     Checked="FilenameStyleRadioButtonChecked"/>

                    <RadioButton Content="lowercase"
                     Name="LowerCaseNameStyle"
                     GroupName="filenameStyleGroup"
                     Checked="FilenameStyleRadioButtonChecked"/>
                    <RadioButton Content="custom"
  Name="CustomNameStyle"
  GroupName="filenameStyleGroup"
  Checked="FilenameStyleRadioButtonChecked"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Include guard style"
        Grid.Column="0"
        Grid.Row="1"
                      Grid.ColumnSpan="2"
        VerticalAlignment="Top">
                <StackPanel>
                    <RadioButton Content="#pragma once" Name="PragmaOnceGuardStyle" Tag="PragmaOnce" Grid.Row="5" GroupName="IncludeGuardStyleGroup" IsChecked="True" VerticalContentAlignment="Center"/>
                    <RadioButton Content="#ifndef ClassName" Name="IfndefGuardStyle" Tag="Ifndef" Grid.Row="6" GroupName="IncludeGuardStyleGroup" IsChecked="False" VerticalContentAlignment="Center"/>
                    <RadioButton Content="#ifndef ClassName__Guid" Name="IfndefGuidGuardStyle" Tag="IfndefGuid" Grid.Row="6" GroupName="IncludeGuardStyleGroup" IsChecked="False" VerticalContentAlignment="Center"/>
                    <RadioButton Content="None" Name="NoneGuardStyle" Tag="IfndefGuid" Grid.Row="6" GroupName="IncludeGuardStyleGroup" IsChecked="False" VerticalContentAlignment="Center"/>
                </StackPanel>
            </GroupBox>

            <StackPanel Grid.Row="0"
            Grid.Column="1"
            VerticalAlignment="Top">

                <Label Content="Header extension" Padding="0"/>
                <ComboBox Name="HeaderExtensionCombo"
              TextBoxBase.TextChanged="HeaderExtensionChangedEventHandler"
              IsEditable="True"/>

                <Label Content="Source extension" Padding="0"/>
                <ComboBox Name="SourceExtensionCombo"
              TextBoxBase.TextChanged="HeaderExtensionChangedEventHandler"
              IsEditable="True"/>

            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="18"
Grid.Column="1"
Grid.ColumnSpan="4"
TextWrapping="Wrap"
VerticalAlignment="Top">
    <Run Text="Error message: "/>
    <Run x:Name="ErrorMessage" Text=""  Foreground="Red"/>
        </TextBlock>

        <Button Name="SelectHeaderSubfolderButton" Click="SelectSubfolderButtonClicked" Content="Select" Grid.Row="1" Grid.Column="4" VerticalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalAlignment="Stretch"/>
        <Button Name="SelectCppSubfolderButton" Click="SelectSubfolderButtonClicked" Content="Select" Grid.Row="3" Grid.Column="4" VerticalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalAlignment="Stretch"/>
        <Button Name="SelectHeaderRootButton" Click="selectHeaderRootButtonClicked" Content="Select" Grid.Row="5" Grid.Column="4" VerticalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalAlignment="Stretch"/>
        <Button Name="SelectCppRootButton" Click="selectCppRootButtonClicked" Content="Select" Grid.Row="7" Grid.Column="4" VerticalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalAlignment="Stretch"/>

    </Grid>
</platform:DialogWindow>
